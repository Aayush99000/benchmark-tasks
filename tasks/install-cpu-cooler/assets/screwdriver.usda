#usda 1.0
(
    defaultPrim = "Screwdriver"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Screwdriver" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.03

    def Cube "tip" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Screwdriver/TipMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0002
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.72)]
        double size = 1
        float3 xformOp:scale = (0.003, 0.0005, 0.006)
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "shaft" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Screwdriver/ShaftMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0002
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.72)]
        double size = 1
        float3 xformOp:scale = (0.003, 0.003, 0.044)
        double3 xformOp:translate = (0, 0, 0.028)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Screwdriver/HandleMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0002
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.85, 0.25, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.018, 0.018, 0.1)
        double3 xformOp:translate = (0, 0, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "ShaftMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.25
        float physics:restitution = 0
        float physics:staticFriction = 0.3
    }

    def Material "TipMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.25
        float physics:restitution = 0
        float physics:staticFriction = 0.3
    }

    def Material "HandleMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1
        float physics:restitution = 0
        float physics:staticFriction = 1.2
    }
}

