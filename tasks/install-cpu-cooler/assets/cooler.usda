    def Material "LeverArmMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.6
        custom token physxMaterial:frictionCombineMode = "average"
    }

    def Material "LeverEndMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.08
        float physics:restitution = 0
        float physics:staticFriction = 0.1
        custom token physxMaterial:frictionCombineMode = "min"
    }

    def PhysicsRevoluteJoint "lever_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        custom float cooler:cam_lift = 0.004
        custom float cooler:lever_snap = 110
        custom float cooler:lever_span = 180
        custom float cooler:lever_stiffness = 0.0005
        float drive:angular:physics:damping = 0.0002
        float drive:angular:physics:stiffness = 0.0005
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </Cooler/leg_pos_slide>
        rel physics:body1 = </Cooler/lever>
        point3f physics:localPos0 = (0, 0.057, 0.066)
        point3f physics:localPos1 = (0, 0.057, 0.066)
        float physics:lowerLimit = 0
        float physics:upperLimit = 183
    }
